{
  "name": "example-webpack-ts",
  "description": "Code coverage from a webpack build of TypeScript sources",
  "private": true,
  "scripts": {
    "cy:run": "cross-env NODE_ENV=test cypress run",
    "cy:open": "cross-env NODE_ENV=test cypress open",
    "build": "cross-env NODE_ENV=test webpack && node -e \"require('fs').copyFileSync('index.html', 'dist/index.html')\"",
    "start": "serve -p 1234 dist",
    "pretest": "rimraf .nyc_output coverage dist",
    "test": "npm run build && start-test 1234 cy:run",
    "coverage:verify": "npx nyc report --check-coverage true --lines 100",
    "coverage:check-files": "check-coverage src/index.ts && check-coverage src/calc.ts && only-covered src/index.ts src/calc.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.28.5",
    "@cypress/webpack-preprocessor": "^6.0.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "7.0.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "webpack": "^5.68.0",
    "webpack-cli": "^5.1.4"
  }
}
