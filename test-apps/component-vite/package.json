{
  "name": "example-component-vite",
  "description": "Code coverage from React component tests served by Vite",
  "private": true,
  "type": "module",
  "scripts": {
    "cy:run": "cypress run --component",
    "pretest": "rimraf .nyc_output coverage",
    "test": "npm run cy:run",
    "coverage:verify": "npx nyc report --check-coverage true --lines 100",
    "coverage:check-files": "check-coverage src/Counter.jsx && only-covered src/Counter.jsx"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.6",
    "vite-plugin-istanbul": "^7.2.1"
  }
}
